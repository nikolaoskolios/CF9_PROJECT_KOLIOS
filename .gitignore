# Live API credential - grants write access to the backend, never commit
api_token.json

# BACKEND/.env is intentionally NOT listed here and IS committed - this is a
# course assignment and the grader needs to clone and run it with zero setup.
# It only holds a JWT signing key, generated for this repo, not a real secret.
# Do not follow this pattern in a real deployment.

