# Committed on purpose. This is a course assignment - the grader needs to be
# able to clone the repo and run it immediately, with nothing to configure.
# In a real deployment this file would never be committed, and SECRET_KEY
# would be provisioned per-environment and rotated if it ever leaked.
SECRET_KEY=8a858a437f6906e55b3e18be77ad717c58f064ba6673a9ba36cf107e87c39b37

# Comma-separated list of origins the frontend is allowed to call this API
# from (CORS). Defaults cover both the dev server (5173) and the local
# production preview (4173) so both run_dev_server and run_prod_server work
# with zero setup. A real deployment would set this to its actual domain(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
